{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "~/.local/bin/agentflow hook --provider copilot --event sessionStart",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "~/.local/bin/agentflow hook --provider copilot --event userPromptSubmitted",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {"type": "command", "bash": "~/.local/bin/agentflow hook --provider copilot --event preToolUse", "timeoutSec": 5}
    ],
    "postToolUse": [
      {"type": "command", "bash": "~/.local/bin/agentflow hook --provider copilot --event postToolUse", "timeoutSec": 5}
    ],
    "postToolUseFailure": [
      {"type": "command", "bash": "~/.local/bin/agentflow hook --provider copilot --event postToolUseFailure", "timeoutSec": 5}
    ],
    "preCompact": [
      {"type": "command", "bash": "~/.local/bin/agentflow hook --provider copilot --event preCompact", "timeoutSec": 5}
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "~/.local/bin/agentflow hook --provider copilot --event agentStop",
        "timeoutSec": 5
      }
    ]
  }
}
