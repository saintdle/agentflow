{
  "schema": "agentflow.project@1",
  "version": 1,
  "model_policy": ".agentflow/models-v1.json",
  "skills": [],
  "workflow_mode": "auto",
  "state_backend": "auto",
  "beads_sync_policy": "manual-selective",
  "beads_parallel_mode": "shared-server-in-git-controller-writes-in-gitless",
  "require_approved_goal": true,
  "require_durable_work_item_before_implementation": true,
  "max_parallel_workers": 3,
  "max_delegation_depth": 1,
  "default_execution_lane": "native",
  "external_session_tool": "herdr",
  "direct_human_intervention_on_blocked": true,
  "require_external_preflight": true,
  "require_acceptance_matrix_for_substantial_work": true,
  "queue_scope": "approved-root-only",
  "queue_labels": ["af:stage", "af:role", "af:cap", "af:mode"],
  "validation_lanes": ["static", "rendered", "local-runtime", "architecture-specific", "hosted-runtime", "manual-ui"],
  "default_reporting": "terse-human-with-next-request",
  "merge_order": ["priority", "fifo"]
}
