{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agentflow hook --provider claude --event SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agentflow hook --provider claude --event PostModelSwitch",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agentflow hook --provider claude --event UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {"hooks": [{"type": "command", "command": "~/.local/bin/agentflow hook --provider claude --event PreToolUse", "timeout": 5}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "~/.local/bin/agentflow hook --provider claude --event PostToolUse", "timeout": 5}]}
    ],
    "PostToolUseFailure": [
      {"hooks": [{"type": "command", "command": "~/.local/bin/agentflow hook --provider claude --event PostToolUseFailure", "timeout": 5}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "~/.local/bin/agentflow hook --provider claude --event PreCompact", "timeout": 5}]}
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agentflow hook --provider claude --event Stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
